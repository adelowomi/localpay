<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS8618;CS8625</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="NuGet">
    <PackageId>LocalPay</PackageId>
    <Version>2.0.0</Version>
    <Authors>Adelowo Ajibola</Authors>
    <Company>Harmonics Technology</Company>
    <Copyright>Copyright (c) 2022 Adelowo Ajibola</Copyright>
    <Description>A .NET SDK that unifies multiple Nigerian payment and utility providers (Flutterwave, Baxi) behind a single, strongly-typed, DI-friendly API surface.</Description>
    <PackageTags>flutterwave;baxi;payments;nigeria;sdk;refit;ngn;bills;airtime;utilities</PackageTags>
    <PackageProjectUrl>https://github.com/adelowomi/localpay</PackageProjectUrl>
    <RepositoryUrl>https://github.com/adelowomi/localpay</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>2.0.0 — multi-target net8.0 + netstandard2.0, IHttpClientFactory-based clients, CancellationToken support throughout, long-typed transaction IDs, System.Text.Json default, refreshed provider endpoints. See CHANGELOG.md for the full list of breaking changes.</PackageReleaseNotes>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Refit" Version="8.0.0" />
    <PackageReference Include="Refit.HttpClientFactory" Version="8.0.0" />
    <PackageReference Include="Refit.Newtonsoft.Json" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
  </ItemGroup>

</Project>
